{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "msnnext",
  "version": "../package.json",
  "identifier": "app.msnnext.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "msnnext",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRkI0RUZDN0I2RUMzNzkKUldSNXcyNTcvRTc3d2o4eXhZUWc4V0xWSlRsUk1jQlZ2amZtMmJwUWx2S3g4ZExMTm9lTGlIL1UK",
      "endpoints": [
        "https://github.com/Nuked88/msn-next/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
